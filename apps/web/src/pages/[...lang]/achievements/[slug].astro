---
import { type Achievement, formatMonth, type Locale, rankShort, tr } from '@portfolio/schema';
import Icon from '../../../components/Icon.astro';
import { href, LOCALES, ui } from '../../../i18n';
import Page from '../../../layouts/Page.astro';
import { achievements, content, projectBySlug } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.flatMap((locale: Locale) =>
    achievements.map((item, i) => ({
      params: { lang: locale === 'en' ? undefined : locale, slug: item.slug },
      props: { locale, item, next: achievements[(i + 1) % achievements.length]! },
    })),
  );
}
interface Props {
  locale: Locale;
  item: Achievement;
  next: Achievement;
}
const { locale, item: a, next } = Astro.props;
const t = ui(locale);
const project = a.projectSlug ? projectBySlug.get(a.projectSlug) : undefined;
const tone =
  a.rankTier === 1
    ? 'var(--volt-400)'
    : a.rankTier === 2
      ? 'var(--ink-200)'
      : a.rankTier === 3
        ? 'var(--flare-400)'
        : 'var(--signal-400)';
const photos = a.galleryMediaIds.map((id) => content.media[id]).filter((m) => m !== undefined);
---

<Page
  locale={locale}
  path={`/achievements/${a.slug}`}
  title={`${tr(a.rankLabel, locale)} — ${tr(a.title, locale)}`}
  description={a.summary ? tr(a.summary, locale) : undefined}
  eyebrow={`${t.achievements.label} · ${formatMonth(a.achievedOn, locale, a.datePrecision)}`}
  back={{ href: `${href(locale, '/')}#achievements`, label: t.achievements.back }}
>
  <header slot="header" class="head">
    <p class="rank display" style={`color:${tone}`} aria-hidden="true">{rankShort(a.rankTier)}</p>
    <h1 class="head__title">
      <span class="chip" style={`border-color:${tone};color:${tone}`}>{tr(a.rankLabel, locale)}</span>
      {tr(a.title, locale)}
    </h1>
  </header>

  <dl class="meta-grid">
    <div>
      <dt class="label">{t.achievements.organizer}</dt>
      <dd>{a.organizer}</dd>
    </div>
    <div>
      <dt class="label">{t.achievements.date}</dt>
      <dd>{formatMonth(a.achievedOn, locale, a.datePrecision)}</dd>
    </div>
    {
      a.location && (
        <div>
          <dt class="label">{t.achievements.location}</dt>
          <dd>{a.location}</dd>
        </div>
      )
    }
    {
      a.typeLabel && (
        <div>
          <dt class="label">{t.achievements.type}</dt>
          <dd>{tr(a.typeLabel, locale)}</dd>
        </div>
      )
    }
    {
      a.scope && (
        <div>
          <dt class="label">{t.achievements.scope}</dt>
          <dd>{t.achievements.scopes[a.scope]}</dd>
        </div>
      )
    }
    {
      a.entryType && (
        <div>
          <dt class="label">{t.achievements.entry}</dt>
          <dd>{t.achievements.entries[a.entryType]}</dd>
        </div>
      )
    }
  </dl>

  <div class="prose">
    {a.summary && <p class="lead">{tr(a.summary, locale)}</p>}
    {
      a.highlights.length > 0 && (
        <>
          <h2>{t.achievements.highlights}</h2>
          <ul>
            {a.highlights.map((h) => (
              <li>{tr(h, locale)}</li>
            ))}
          </ul>
        </>
      )
    }
    {
      a.proofs.length > 0 && (
        <>
          <h2>{t.achievements.proofs}</h2>
          <ul>
            {a.proofs.map((p, i) => {
              const url = p.url ?? (p.mediaId ? content.media[p.mediaId]?.url : undefined);
              return url ? (
                <li>
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    {p.label ? tr(p.label, locale) : `${t.achievements.proof} ${i + 1}`}
                  </a>
                </li>
              ) : null;
            })}
          </ul>
        </>
      )
    }
  </div>

  {
    photos.length > 0 && (
      <ul class="photos">
        {photos.map((m) => (
          <li>
            <img src={m.url} width={m.width} height={m.height} alt={tr(m.alt, locale)} loading="lazy" decoding="async" />
          </li>
        ))}
      </ul>
    )
  }

  {
    project && !project.isPlaceholder && (
      <a class="linked" href={href(locale, `/works/${project.slug}`)} data-sound="hover nav">
        <span class="label">{t.achievements.linkedProject}</span>
        <span class="linked__title">{tr(project.title, locale)}</span>
        <Icon name="arrow-up-right" size={28} />
      </a>
    )
  }

  <p class="next-link">
    <span class="label">{t.achievements.next}</span>
    <a class="display" href={href(locale, `/achievements/${next.slug}`)} data-sound="hover nav">
      {rankShort(next.rankTier)} · {next.organizer} <Icon name="arrow-right" size={36} />
    </a>
  </p>
</Page>

<style>
  .head {
    display: grid;
    gap: 8px;
    margin-bottom: clamp(24px, 4vw, 48px);
  }
  .rank {
    font-size: clamp(6rem, 24vw, 18rem);
    line-height: 0.82;
  }
  .head__title {
    display: grid;
    gap: 12px;
    justify-items: start;
    font-size: clamp(1.75rem, 4.4vw, 3.5rem);
    line-height: 1.08;
    font-weight: 650;
    letter-spacing: -0.025em;
    max-width: 24ch;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 12px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .linked {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 16px;
    align-items: center;
    margin-top: 40px;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid color-mix(in srgb, var(--volt-400) 50%, transparent);
    border-radius: var(--radius-xl);
    background: var(--ink-900);
    transition: border-color var(--dur-base) ease;
  }
  .linked:hover {
    border-color: var(--volt-400);
  }
  .linked .label {
    grid-column: 1;
  }
  .linked__title {
    grid-column: 1;
    font-size: clamp(1.25rem, 2.6vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .linked :global(svg) {
    grid-column: 2;
    grid-row: 1 / span 2;
  }
</style>
