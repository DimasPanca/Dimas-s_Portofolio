---
import { formatMonth, tr } from '@portfolio/schema';
import Icon from '../../components/Icon.astro';
import { href, localeFromParam, localePaths, ui } from '../../i18n';
import Page from '../../layouts/Page.astro';
import {
  achievements,
  education,
  experiences,
  period,
  projects,
  settings,
  skills,
  whatsappHref,
} from '../../lib/content';

export const getStaticPaths = localePaths;
const locale = localeFromParam(Astro.params.lang);
const t = ui(locale);
const p = settings.profile;
const work = experiences.filter((e) => e.kind === 'work');
const orgs = experiences.filter((e) => e.kind === 'organization');
const hard = skills.filter((s) => s.kind === 'hard' && !s.isPlaceholder);
const soft = skills.filter((s) => s.kind === 'soft');
const realProjects = projects.filter((x) => !x.isPlaceholder);
const links = settings.socials.filter((s) => s.kind !== 'email');
---

<Page locale={locale} path="/cv" title={t.cv.title} back={{ href: href(locale, '/'), label: t.nav.home }} paper>
  <header slot="header" class="cv-head">
    <div>
      <h1 class="display cv-name">{p.name}</h1>
      <p class="cv-headline">{tr(p.headline, locale)}</p>
      <p class="cv-contact">
        {p.location} · <a href={`mailto:${p.email}`}>{p.email}</a>
        {links.map((l) => <> · <a href={l.url}>{l.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></>)}
        {whatsappHref && <> · <a href={whatsappHref}>WhatsApp</a></>}
      </p>
    </div>
    <div class="cv-actions no-print">
      <button class="btn btn--ink" type="button" onclick="window.print()">
        <Icon name="printer" size={18} />{t.cv.print}
      </button>
      {
        settings.cvPath && (
          <a class="btn btn--ghost" href={settings.cvPath} download data-track="cv_download">
            <Icon name="download" size={18} />
            {t.cv.download}
          </a>
        )
      }
    </div>
  </header>

  <div class="cv">
    <section>
      <h2>{t.cv.summary}</h2>
      <p>{tr(p.bio, locale)}</p>
    </section>

    <section>
      <h2>{t.cv.experience}</h2>
      {
        work.map((e) => (
          <div class="row">
            <p class="when">{period(e, locale, t.journey.present)}</p>
            <div>
              <h3>
                {tr(e.role, locale)} — {e.organization}
              </h3>
              <ul>
                {e.highlights.map((h) => (
                  <li>{tr(h, locale)}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t.cv.organization}</h2>
      {
        orgs.map((e) => (
          <div class="row">
            <p class="when">{period(e, locale, t.journey.present)}</p>
            <div>
              <h3>
                {tr(e.role, locale)} — {e.organization}
              </h3>
              <ul>
                {e.highlights.map((h) => (
                  <li>{tr(h, locale)}</li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t.cv.education}</h2>
      {
        education.map((e) => (
          <div class="row">
            <p class="when">
              {formatMonth(e.startOn, locale)} — {e.endOn ? formatMonth(e.endOn, locale) : t.journey.present}
              {e.isExpected ? ` (${t.about.expected})` : ''}
            </p>
            <div>
              <h3>
                {tr(e.program, locale)} — {e.institution}
              </h3>
              {e.gpa != null && (
                <p>
                  {t.journey.gpa} {e.gpa.toFixed(2)} / {e.gpaScale.toFixed(2)}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t.cv.achievements}</h2>
      {
        achievements.map((a) => (
          <div class="row row--tight">
            <p class="when">{formatMonth(a.achievedOn, locale, a.datePrecision)}</p>
            <p>
              <b>{tr(a.rankLabel, locale)}</b> — {tr(a.title, locale)}, {a.organizer}
              {a.location ? ` (${a.location})` : ''}
            </p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t.cv.projects}</h2>
      {
        realProjects.map((x) => (
          <div class="row row--tight">
            <p class="when">{x.year}</p>
            <p>
              <b>{tr(x.title, locale)}</b>
              {x.role ? ` — ${tr(x.role, locale)}` : ''}. {x.summary ? tr(x.summary, locale) : ''}
            </p>
          </div>
        ))
      }
    </section>

    <section>
      <h2>{t.cv.skills}</h2>
      <p>{hard.map((s) => tr(s.label, locale)).join(' · ')}</p>
      <p>{soft.map((s) => tr(s.label, locale)).join(' · ')}</p>
    </section>
  </div>
</Page>

<style>
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 20px;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid var(--ink-950);
  }
  .cv-name {
    font-size: clamp(2.5rem, 7vw, 5rem);
  }
  .cv-headline {
    margin-top: 8px;
    font-weight: 500;
  }
  .cv-contact {
    margin-top: 6px;
    font-size: 0.875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .cv-contact a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cv {
    display: grid;
    gap: 26px;
    max-width: 920px;
    font-size: 0.9688rem;
    line-height: 1.55;
  }
  .cv h2 {
    margin-bottom: 10px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .row {
    display: grid;
    gap: 2px 20px;
    margin-bottom: 14px;
    break-inside: avoid;
  }
  .row--tight {
    margin-bottom: 6px;
  }
  .when {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .cv h3 {
    font-weight: 650;
  }
  .cv ul {
    margin: 4px 0 0;
    padding-left: 1.1em;
    list-style: disc;
  }
  @media (min-width: 720px) {
    .row {
      grid-template-columns: 150px minmax(0, 1fr);
    }
  }
  @media print {
    :global(html),
    :global(body),
    :global(.page.paper) {
      background: #fff !important;
      color: #000 !important;
    }
    :global(.page) {
      padding: 0 !important;
      min-height: 0 !important;
    }
    :global(.wrap) {
      padding: 0 !important;
      max-width: none !important;
    }
    .cv {
      font-size: 9.5pt;
      gap: 12pt;
      max-width: none;
    }
    .cv-name {
      font-size: 26pt;
    }
    .row {
      grid-template-columns: 92pt minmax(0, 1fr);
      margin-bottom: 6pt;
    }
    @page {
      size: A4;
      margin: 14mm;
    }
  }
</style>
