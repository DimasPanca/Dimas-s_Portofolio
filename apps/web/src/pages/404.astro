---
import { ui } from '../i18n';
import Page from '../layouts/Page.astro';

const t = ui('en');
---

<Page locale="en" path="/404" title={t.notFound.title} noindex singleLocale>
  <p class="label log">&gt; {t.notFound.log}<span class="caret" aria-hidden="true"></span></p>
  <p style="margin-top:28px">
    <a class="btn btn--volt" href="/" data-sound="hover click">{t.notFound.home}</a>
  </p>
</Page>

<style>
  .log {
    font-size: 0.9375rem;
    color: var(--ink-200);
  }
  .caret {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 4px;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1s steps(2) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
</style>
