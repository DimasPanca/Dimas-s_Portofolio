---
import { type Locale, tr } from '@portfolio/schema';
import { href, ui } from '../i18n';
import { settings } from '../lib/content';

/** Rotating text badge + explorer HUD, desktop only (PRD §5.2 FR-NAV / FR-HUD). */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const text = settings.availability ? tr(settings.availability, locale) : settings.profile.name;
const ring = `${text} • ${text} • `.toUpperCase();
---

<a class="badge no-print" href={`${href(locale, '/')}#contact`} aria-label={`${text} — ${t.nav.contact}`} data-sound="hover click" data-badge>
  <svg viewBox="0 0 120 120" aria-hidden="true" focusable="false">
    <defs><path id="badge-ring" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"></path></defs>
    <text class="badge__text"><textPath href="#badge-ring" textLength="282">{ring}</textPath></text>
  </svg>
  <span class="badge__core display">DP</span>
  <span class="badge__hud label" aria-hidden="true">{t.misc.explored} <b data-explored>0/8</b></span>
</a>

<style>
  .badge {
    display: none;
  }
  @media (min-width: 1024px) and (min-height: 700px) {
    .badge {
      position: fixed;
      left: 22px;
      bottom: 22px;
      z-index: 60;
      display: grid;
      place-items: center;
      width: 116px;
      height: 116px;
      border-radius: 50%;
      mix-blend-mode: difference;
      color: #fff;
      opacity: 0;
      transform: scale(0.8);
      transition:
        opacity var(--dur-slow) ease,
        transform var(--dur-slow) var(--ease-spring);
    }
    :global(html[data-scrolled]) .badge {
      opacity: 1;
      transform: none;
    }
    :global(html:not(.js)) .badge {
      opacity: 1;
      transform: none;
    }
  }
  .badge svg {
    position: absolute;
    inset: 0;
    animation: badge-spin 22s linear infinite;
  }
  .badge:hover svg {
    animation-duration: 8s;
  }
  .badge__text {
    font-family: var(--font-mono);
    font-size: 9.500px;
    letter-spacing: 0.08em;
    fill: currentColor;
  }
  .badge__core {
    font-size: 1.75rem;
  }
  .badge__hud {
    position: absolute;
    left: calc(100% + 10px);
    bottom: 8px;
    white-space: nowrap;
    color: currentColor;
  }
  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
