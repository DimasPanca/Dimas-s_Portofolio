---
import type { Locale } from '@portfolio/schema';
import { ui } from '../i18n';
import { projects, settings, stats } from '../lib/content';

/**
 * Loading screen (PRD §5.2). Runs on its own (silent: browsers block audio before a gesture) and ends
 * with one "enter" action that also turns the sound on. Only rendered when the inline boot script
 * marks it open, so without JavaScript it never shows.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const realProjects = projects.filter((p) => !p.isPlaceholder).length;
const [boot, profile, mounting, compiling, signal] = t.gate.boot;
const lines = [
  `${boot} — ${t.gate.ok}`,
  `${profile} — ${t.gate.ok}`,
  `${mounting} — ${stats.achievements} ${t.gate.found}`,
  `${compiling} — ${realProjects} ${t.gate.ok}`,
  `${signal} — ${t.gate.online}`,
];
const word = `${settings.profile.name.split(' ')[0]?.toUpperCase() ?? 'DIMAS'}.`;
const year = new Date().getFullYear();
---

<div
  class="gate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gate-title"
  aria-describedby="gate-status"
  data-gate-root
  data-lines={JSON.stringify(lines)}
>
  <div class="gate__band" aria-hidden="true"></div>
  <div class="gate__panel">
    <canvas class="gate__lines" data-gate-lines aria-hidden="true"></canvas>
    <span class="gate__cross" data-gate-cross aria-hidden="true"><i></i><b data-gate-xy>0000 · 0000</b></span>

    <div class="gate__top label" aria-hidden="true">
      <span>{settings.profile.name}</span>
      <span>{t.gate.portfolio} — ©{year}</span>
    </div>

    <div class="gate__center">
      <h2 id="gate-title" class="sr-only">{t.gate.title}</h2>
      <p class="gate__word display" aria-hidden="true" data-gate-word>
        {
          [...word].map((ch, i) => (
            <span class="gate__ch" style={`--i:${i}`}>
              <span class="gate__ghost">{ch}</span>
              <span class="gate__fill">{ch}</span>
            </span>
          ))
        }
      </p>
      <div class="gate__enter-wrap">
        <button class="gate__enter" type="button" data-gate-enter tabindex="-1">
          <i aria-hidden="true"></i>
          <span class="gate__enter-fine">{t.gate.enterClick}</span>
          <span class="gate__enter-touch">{t.gate.enterTap}</span>
        </button>
        <p class="gate__hint label">{t.gate.hint}</p>
      </div>
    </div>

    <div class="gate__bottom">
      <p class="gate__status label" id="gate-status" aria-live="polite">
        <span aria-hidden="true">&gt;</span>
        <span data-gate-status>{lines[0]}</span>
      </p>
      <p class="gate__count display" aria-hidden="true"><span data-gate-count>000</span><small>%</small></p>
    </div>
    <div class="gate__bar" aria-hidden="true"><i data-gate-bar></i></div>
  </div>
</div>

<style>
  .gate {
    display: none;
  }
  :global(html[data-gate='open']) .gate,
  :global(html[data-gate='closing']) .gate {
    position: fixed;
    inset: 0;
    z-index: 150;
    display: block;
    overflow: hidden;
    color: var(--fg);
    touch-action: none;
  }
  :global(html[data-gate='open']),
  :global(html[data-gate='closing']) {
    overflow: hidden;
  }
  .gate__band,
  .gate__panel {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .gate__band {
    background: var(--accent);
  }
  .gate__panel {
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: max(18px, env(safe-area-inset-top)) var(--page-margin) max(18px, env(safe-area-inset-bottom));
    background:
      radial-gradient(70% 55% at 50% 50%, rgb(212 255 63 / 0.05), transparent 70%),
      var(--ink-950);
  }
  .gate__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Crosshair: follows the pointer on desktop, rests beside the wordmark elsewhere. */
  .gate__cross {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    pointer-events: none;
    transform: translate3d(var(--cx, 62vw), var(--cy, 40svh), 0);
    opacity: 0.8;
  }
  .gate__cross i {
    position: relative;
    width: 15px;
    height: 15px;
    margin: -7px 0 0 -7px;
  }
  .gate__cross i::before,
  .gate__cross i::after {
    content: '';
    position: absolute;
    background: var(--fg);
  }
  .gate__cross i::before {
    left: 7px;
    top: 0;
    width: 1px;
    height: 15px;
  }
  .gate__cross i::after {
    top: 7px;
    left: 0;
    width: 15px;
    height: 1px;
  }
  .gate__cross b {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: var(--ink-400);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .gate__top,
  .gate__bottom {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .gate__top {
    align-items: flex-start;
    color: var(--ink-300);
  }
  .gate__center {
    position: relative;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: clamp(18px, 3svh, 30px);
    text-align: center;
  }
  .gate__word {
    display: flex;
    margin: 0;
    font-size: clamp(5rem, 24vw, 15rem);
    line-height: 0.86;
    letter-spacing: 0.005em;
  }
  .gate__ch {
    position: relative;
    display: inline-block;
  }
  .gate__ghost {
    display: block;
    color: transparent;
    -webkit-text-stroke: 1px rgb(245 245 242 / 0.28);
  }
  .gate__fill {
    position: absolute;
    inset: 0;
    color: var(--fg);
    clip-path: inset(100% 0 0 0);
    transition:
      clip-path 520ms var(--ease-out-expo),
      color 420ms ease;
  }
  .gate__ch.is-lit .gate__fill {
    clip-path: inset(-0.05em -0.05em -0.1em -0.05em);
  }
  .gate__ch.is-lit:last-child .gate__fill,
  :global(html[data-gate-ready]) .gate__fill {
    color: var(--accent);
  }

  .gate__enter-wrap {
    display: grid;
    justify-items: center;
    gap: 12px;
    min-height: 92px;
    opacity: 0;
    transform: translateY(10px);
    pointer-events: none;
    transition:
      opacity 600ms var(--ease-out-expo),
      transform 700ms var(--ease-out-expo);
  }
  :global(html[data-gate-ready]) .gate__enter-wrap {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .gate__enter {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 54px;
    padding: 0 26px 0 22px;
    border: 1px solid rgb(245 245 242 / 0.35);
    border-radius: var(--radius-full);
    background: rgb(10 10 11 / 0.55);
    backdrop-filter: blur(6px);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.01em;
    transition:
      background-color var(--dur-base) ease,
      color var(--dur-base) ease,
      border-color var(--dur-base) ease,
      transform var(--dur-base) var(--ease-spring);
  }
  .gate__enter:hover,
  .gate__enter:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink-950);
  }
  .gate__enter:active {
    transform: scale(0.97);
  }
  .gate__enter i {
    position: relative;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    transition: background-color var(--dur-base) ease;
  }
  .gate__enter:hover i,
  .gate__enter:focus-visible i {
    background: var(--ink-950);
  }
  .gate__enter i::after {
    content: '';
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: gate-ping 1.8s var(--ease-out-expo) infinite;
  }
  @keyframes gate-ping {
    from {
      transform: scale(0.4);
      opacity: 1;
    }
    to {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  .gate__enter-touch {
    display: none;
  }
  @media (max-width: 767px) {
    .gate__word {
      font-size: 31vw;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .gate__cross,
    .gate__enter-fine {
      display: none;
    }
    .gate__enter-touch {
      display: inline;
    }
  }
  .gate__hint {
    color: var(--ink-400);
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .gate__status {
    display: flex;
    gap: 8px;
    max-width: min(62vw, 420px);
    margin: 0 0 6px;
    color: var(--ink-300);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .gate__status > span:first-child {
    color: var(--accent);
  }
  .gate__count {
    margin: 0;
    font-size: clamp(3rem, 9vw, 6.5rem);
    line-height: 0.82;
    font-variant-numeric: tabular-nums;
  }
  .gate__count small {
    font-size: 0.32em;
    margin-left: 0.08em;
    color: var(--ink-400);
    vertical-align: top;
  }
  .gate__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgb(245 245 242 / 0.08);
  }
  .gate__bar i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }

  /* ---- exit: the content charges, then two curtains lift (ink first, volt a beat later) ---- */
  :global(html[data-gate='closing']) .gate {
    pointer-events: none;
  }
  :global(html[data-gate='closing']) .gate__panel {
    transform: translate3d(0, -100%, 0);
    transition: transform 1000ms cubic-bezier(0.76, 0, 0.24, 1) 260ms;
  }
  :global(html[data-gate='closing']) .gate__band {
    transform: translate3d(0, -100%, 0);
    transition: transform 1000ms cubic-bezier(0.76, 0, 0.24, 1) 400ms;
  }
  :global(html[data-gate='closing']) .gate__word {
    transform: translate3d(0, 18svh, 0) scale(1.04);
    transition: transform 1260ms cubic-bezier(0.76, 0, 0.24, 1);
  }
  :global(html[data-gate='closing']) .gate__fill {
    color: var(--accent);
    clip-path: inset(-0.05em -0.05em -0.1em -0.05em);
  }
  :global(html[data-gate='closing']) .gate__enter-wrap,
  :global(html[data-gate='closing']) .gate__top,
  :global(html[data-gate='closing']) .gate__bottom,
  :global(html[data-gate='closing']) .gate__cross,
  :global(html[data-gate='closing']) .gate__bar {
    opacity: 0;
    transition: opacity 240ms ease;
  }

  @media (min-width: 768px) {
    .gate__panel {
      padding-block: 28px;
    }
  }

  /* Reduced motion / static tier: no lines, no curtain, a short fade. */
  :global(html[data-tier='static']) .gate__lines,
  :global(html[data-tier='static']) .gate__cross {
    display: none;
  }
  :global(html[data-tier='static'][data-gate='closing']) .gate__panel,
  :global(html[data-tier='static'][data-gate='closing']) .gate__band,
  :global(html[data-tier='static'][data-gate='closing']) .gate__word {
    transform: none;
    transition: none;
  }
  :global(html[data-tier='static'][data-gate='closing']) .gate {
    opacity: 0;
    transition: opacity 300ms linear;
  }
  @media (prefers-reduced-motion: reduce) {
    .gate__fill {
      transition: none;
    }
    .gate__enter i::after {
      animation: none;
    }
  }
</style>
