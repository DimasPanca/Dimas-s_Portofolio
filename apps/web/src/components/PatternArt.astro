---
/** Generated cover art for items without a real image (PRD §4.6). Deterministic per seed, pure SVG. */
interface Props {
  seed: string;
  tone?: 'volt' | 'silver' | 'flare' | 'signal';
  label?: string;
}
const { seed, tone = 'volt', label } = Astro.props;
let h = 2166136261;
for (const ch of seed) h = Math.imul(h ^ ch.charCodeAt(0), 16777619);
const rnd = () => {
  h ^= h << 13;
  h ^= h >>> 17;
  h ^= h << 5;
  return ((h >>> 0) % 1000) / 1000;
};
const color = { volt: '#d4ff3f', silver: '#d4d4d8', flare: '#ff6a4d', signal: '#7c8cff' }[tone];
const cx = 30 + rnd() * 40;
const cy = 25 + rnd() * 50;
const rings = Array.from({ length: 7 }, (_, i) => 8 + i * (9 + rnd() * 3));
const dots = Array.from({ length: 10 }, () => ({ x: rnd() * 100, y: rnd() * 100, r: 0.4 + rnd() * 0.9 }));
const id = `g-${seed.replace(/[^a-z0-9]/gi, '')}`;
---

<svg class="art" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={id} cx={`${cx}%`} cy={`${cy}%`} r="75%">
      <stop offset="0" stop-color={color} stop-opacity="0.28"></stop>
      <stop offset="0.55" stop-color={color} stop-opacity="0.05"></stop>
      <stop offset="1" stop-color="#101012" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  <rect width="100" height="100" fill="#141417"></rect>
  <rect width="100" height="100" fill={`url(#${id})`}></rect>
  {rings.map((r, i) => <circle cx={cx} cy={cy} r={r} fill="none" stroke={color} stroke-opacity={0.42 - i * 0.05} stroke-width="0.35" />)}
  {dots.map((d) => <circle cx={d.x} cy={d.y} r={d.r} fill={color} fill-opacity="0.5" />)}
  {
    label && (
      <text x="6" y="94" font-family="Anton, Impact, sans-serif" font-size="22" fill={color} fill-opacity="0.9">
        {label}
      </text>
    )
  }
</svg>

<style>
  .art {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
