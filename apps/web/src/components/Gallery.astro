---
import { type Locale, tr } from '@portfolio/schema';
import { ui } from '../i18n';
import { content, gallery } from '../lib/content';
import Icon from './Icon.astro';
import PatternArt from './PatternArt.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
// Real photos first; placeholder tiles only fill the grid up to six slots (PRD §5.9).
const real = gallery.filter((g) => !g.isPlaceholder && g.mediaId && content.media[g.mediaId]);
const fillers = gallery.filter((g) => g.isPlaceholder).slice(0, Math.max(0, 6 - real.length));
const tones = ['volt', 'signal', 'silver', 'flare'] as const;
---

<section class="section gallery" id="gallery" aria-labelledby="gallery-h">
  <div class="wrap gallery__head">
    <div>
      <p class="label" data-reveal>07 / {t.gallery.label}</p>
      <h2 id="gallery-h" class="title" data-reveal>{t.gallery.title}</h2>
    </div>
    <p class="lead" data-reveal>{t.gallery.intro}</p>
  </div>
  <ul class="wrap gallery__grid">
    {
      real.map((g, i) => {
        const m = content.media[g.mediaId!]!;
        return (
          <li class:list={['tile', `tile--${i % 5}`]} data-reveal style={`--i:${i % 3}`}>
            <figure>
              <img src={m.url} width={m.width} height={m.height} alt={tr(m.alt, locale)} loading="lazy" decoding="async" />
              {(g.caption || g.album) && (
                <figcaption class="label">
                  {g.caption ? tr(g.caption, locale) : g.album}
                </figcaption>
              )}
            </figure>
          </li>
        );
      })
    }
    {
      fillers.map((g, i) => (
        <li class:list={['tile', 'tile--ph', `tile--${(real.length + i) % 5}`]} data-reveal style={`--i:${i % 3}`}>
          <figure>
            <PatternArt seed={g.slug} tone={tones[i % tones.length]} />
            <figcaption class="label">
              <Icon name="image" size={14} /> {t.gallery.placeholder}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .gallery__head {
    display: grid;
    gap: 20px;
    margin-bottom: 36px;
  }
  .gallery__head .title {
    margin-top: 14px;
  }
  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding-block: 0;
    list-style: none;
  }
  .tile figure {
    position: relative;
    margin: 0;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    overflow: clip;
    border: 1px solid var(--line);
    background: var(--ink-900);
  }
  .tile--0 figure,
  .tile--3 figure {
    aspect-ratio: 4 / 5;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slower) var(--ease-out-expo);
  }
  .tile:hover :global(img) {
    transform: scale(1.04);
  }
  .tile figcaption {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0.4em 0.8em;
    border-radius: var(--radius-full);
    background: rgb(10 10 11 / 0.72);
    color: var(--ink-200);
  }
  .tile--ph figure {
    border-style: dashed;
    opacity: 0.8;
  }
  @media (min-width: 900px) {
    .gallery__head {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
    .gallery__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
    }
  }
</style>
