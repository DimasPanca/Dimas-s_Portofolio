---
import { Picture } from 'astro:assets';
import { type Locale, type SkillGroup, tr } from '@portfolio/schema';
import full from '../assets/portrait/full.webp';
import { ui } from '../i18n';
import { settings, skills } from '../lib/content';
import Icon, { type IconName } from './Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const order: SkillGroup[] = ['stack', 'ai', 'web', 'iot', 'tools', 'leadership'];
const icons: Record<SkillGroup, IconName> = {
  stack: 'code',
  ai: 'brain',
  web: 'external',
  iot: 'chip',
  tools: 'tool',
  leadership: 'users',
};
const groups = order
  .map((g) => ({ key: g, items: skills.filter((s) => s.group === g && !s.isPlaceholder) }))
  .filter((g) => g.items.length > 0);
const hard = skills.filter((s) => s.kind === 'hard' && !s.isPlaceholder).map((s) => tr(s.label, locale));
const soft = skills.filter((s) => s.kind === 'soft').map((s) => tr(s.label, locale));
const credo = settings.credo;
---

<section class="section skills" id="skills" aria-labelledby="skills-h">
  <div class="wrap skills__head">
    <div>
      <p class="label" data-reveal>06 / {t.skills.label}</p>
      <h2 id="skills-h" class="title" data-reveal>{t.skills.title}</h2>
    </div>
    <p class="lead" data-reveal>{t.skills.intro}</p>
  </div>

  <div class="wrap skills__grid">
    {
      groups.map((g, i) => (
        <article class:list={['group', { 'group--wide': g.key === 'stack' || g.key === 'leadership' }]} data-reveal style={`--i:${i % 3}`}>
          <h3 class="label group__title">
            <span class="group__icon">
              <Icon name={icons[g.key]} size={16} />
            </span>
            {t.skills.groups[g.key]}
          </h3>
          <ul>
            {g.items.map((s) => (
              <li class:list={{ big: g.key === 'stack' }} data-sound="hover">
                {tr(s.label, locale)}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  <div class="skills__marquees" aria-hidden="true">
    {
      [hard, soft].map((row, r) => (
        <div class="marquee" style={`--marquee-duration:${r ? 46 : 54}s; --marquee-direction:${r ? 'reverse' : 'normal'}`} data-velocity-marquee>
          {[0, 1].map(() => (
            <div class="marquee__track display">
              {[...row, ...row].map((w) => (
                <span class:list={{ stroke: r === 1 }}>
                  {w}
                  <i>✦</i>
                </span>
              ))}
            </div>
          ))}
        </div>
      ))
    }
  </div>

  {
    credo && (
      <div class="wrap credo" data-credo>
        <div class="credo__words display" aria-label={credo.words.join(' · ')}>
          {credo.words.map((w, i) => (
            <span class:list={{ 'is-active': i === 0 }} data-credo-word aria-hidden="true">
              {w}
            </span>
          ))}
        </div>
        <div class="credo__side">
          <div class="credo__photo">
            <Picture src={full} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 900px) 30vw, 60vw" alt="" loading="lazy" decoding="async" quality={60} fallbackFormat="webp" />
          </div>
          <p class="credo__line">{tr(credo.sentence, locale)}</p>
        </div>
      </div>
    )
  }
</section>

<style>
  .skills {
    overflow: clip;
  }
  .skills__head {
    display: grid;
    gap: 20px;
    margin-bottom: 40px;
  }
  .skills__head .title {
    margin-top: 14px;
  }
  .skills__grid {
    display: grid;
    gap: 14px;
  }
  .group {
    padding: clamp(18px, 2.2vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--ink-900);
  }
  .group__title {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-200);
  }
  .group__icon {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--accent);
    color: var(--ink-950);
  }
  .group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .group li {
    padding: 0.55em 0.95em;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      transform var(--dur-base) var(--ease-spring);
  }
  .group li:hover {
    background: var(--fg);
    color: var(--ink-950);
    transform: translateY(-2px);
  }
  .group li.big {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    padding: 0.4em 0.7em 0.34em;
    border-radius: var(--radius-md);
  }
  .skills__marquees {
    display: grid;
    gap: 6px;
    margin-block: clamp(56px, 9vw, 120px);
    font-size: clamp(2.5rem, 6.5vw, 6rem);
  }
  .skills__marquees span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }
  .skills__marquees i {
    font-style: normal;
    font-size: 0.35em;
    margin-inline: 0.9em;
    color: var(--accent);
    -webkit-text-stroke: 0;
  }
  .credo {
    display: grid;
    gap: 28px;
    align-items: end;
  }
  .credo__words {
    display: grid;
    font-size: clamp(5rem, 22vw, 20rem);
    line-height: 0.84;
  }
  .credo__words span {
    color: var(--ink-700);
    transition: color var(--dur-slow) ease;
  }
  .credo__words span.is-active {
    color: var(--fg);
  }
  :global(html:not(.js)) .credo__words span,
  :global(html[data-tier='static']) .credo__words span {
    color: var(--fg);
  }
  .credo__side {
    display: grid;
    gap: 18px;
  }
  .credo__photo {
    width: min(60vw, 300px);
    aspect-ratio: 3 / 4;
    overflow: clip;
    border-radius: var(--radius-xl);
    background: radial-gradient(80% 60% at 50% 30%, rgb(212 255 63 / 0.16), transparent 70%), var(--ink-850);
    border: 1px solid var(--line);
  }
  .credo__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .credo__line {
    font-size: var(--fs-lead);
    max-width: 34ch;
    color: var(--ink-200);
  }
  @media (min-width: 900px) {
    .skills__head {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
    .skills__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .group--wide {
      grid-column: span 3;
    }
    .credo {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
    .credo__side {
      justify-items: end;
      text-align: right;
    }
  }
</style>
