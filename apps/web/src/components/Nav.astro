---
import type { Locale } from '@portfolio/schema';
import { href, ui } from '../i18n';
import { settings } from '../lib/content';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  path: string;
  singleLocale?: boolean;
}
const { locale, path, singleLocale = false } = Astro.props;
const t = ui(locale);
const home = href(locale, '/');
const sections = ['about', 'achievements', 'journey', 'works', 'skills', 'contact'] as const;
const other: Locale = locale === 'en' ? 'id' : 'en';
const cvHref = href(locale, '/cv');
---

<header class="nav no-print" data-nav>
  <div class="nav__bar">
    <a class="nav__logo" href={home} aria-label={`${settings.profile.name} — ${t.nav.home}`} data-sound="nav">
      <span class="display">DP</span><span class="nav__dot" data-signal></span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        sections.map((s) => (
          <a href={`${home}#${s}`} data-nav-link={s} data-sound="hover nav">
            {t.nav[s]}
          </a>
        ))
      }
    </nav>

    <div class="nav__tools">
      {
        !singleLocale && (
          <a class="nav__lang label" href={href(other, path)} hreflang={other} lang={other} data-lang-switch={other} data-sound="toggle">
            <span class:list={{ on: locale === 'en' }}>EN</span>
            <span aria-hidden="true">/</span>
            <span class:list={{ on: locale === 'id' }}>ID</span>
            <span class="sr-only">{t.nav.language}</span>
          </a>
        )
      }
      <button class="nav__sound" type="button" aria-pressed="false" data-sound-toggle aria-label={t.nav.sound}>
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>
      <a class="btn btn--volt nav__cv" href={cvHref} data-sound="hover click" data-track="cv_download">
        {t.nav.cv}
      </a>
      <a class="nav__menu" href="#footer-nav" data-menu-open aria-haspopup="dialog" data-sound="click">
        {t.nav.menu}<span class="nav__menu-dot" aria-hidden="true"></span>
      </a>
    </div>
  </div>
  <div class="nav__progress" aria-hidden="true"><i data-progress></i></div>
</header>

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label={t.nav.menu} hidden data-menu>
  <button class="menu__close btn btn--ghost" type="button" data-menu-close>
    {t.nav.close}<Icon name="close" size={18} />
  </button>
  <nav class="menu__links" aria-label="Menu">
    {
      [...sections.slice(0, 5), 'gallery' as const, 'contact' as const].map((s, i) => (
        <a class="display" href={`${home}#${s}`} data-menu-link style={`--i:${i}`}>
          <span class="label">0{i + 1}</span>
          {t.nav[s]}
        </a>
      ))
    }
  </nav>
  <div class="menu__foot">
    <a class="link-u" href={`mailto:${settings.contact.email}`}>{settings.contact.email}</a>
    <div class="menu__socials">
      {
        settings.socials
          .filter((s) => s.kind !== 'email')
          .map((s) => (
            <a href={s.url} target="_blank" rel="noopener noreferrer" class="label link-u">
              {s.label}
            </a>
          ))
      }
    </div>
  </div>
</div>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 80;
    padding: 14px var(--page-margin) 0;
    pointer-events: none;
    transition: transform var(--dur-base) var(--ease-out-expo);
  }
  .nav[data-hidden] {
    transform: translateY(-130%);
  }
  .nav__bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    max-width: 1180px;
    margin-inline: auto;
    padding: 8px 8px 8px 20px;
    border-radius: var(--radius-full);
    border: 1px solid var(--line);
    background: rgb(16 16 18 / 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }
  :global(html[data-tier='static']) .nav__bar,
  :global(html[data-tier='low']) .nav__bar {
    background: var(--ink-850);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .nav__logo {
    display: inline-flex;
    align-items: baseline;
    gap: 3px;
    font-size: 1.5rem;
    line-height: 1;
    min-height: 44px;
    align-items: center;
  }
  .nav__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--flare-500);
    align-self: flex-end;
    margin-bottom: 12px;
    transition: background-color var(--dur-base) ease;
  }
  :global(html[data-sound='on']) .nav__dot {
    background: var(--accent);
    animation: pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      transform: scale(1.5);
      opacity: 0.6;
    }
  }
  .nav__links {
    display: none;
    gap: 4px;
  }
  .nav__links a {
    position: relative;
    padding: 0.7em 0.9em;
    font-size: 0.875rem;
    color: var(--ink-200);
    border-radius: var(--radius-full);
    transition: color var(--dur-fast) ease;
  }
  .nav__links a:hover,
  .nav__links a[aria-current] {
    color: #fff;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0.9em;
    right: 0.9em;
    bottom: 0.4em;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-base) var(--ease-spring);
  }
  .nav__links a[aria-current]::after {
    transform: scaleX(1);
  }
  .nav__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav__lang {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    min-height: 44px;
    padding-inline: 10px;
    color: var(--ink-400);
  }
  .nav__lang .on {
    color: #fff;
  }
  .nav__sound {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
  }
  .nav__sound:hover {
    border-color: var(--ink-400);
  }
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 14px;
  }
  .bars i {
    width: 3px;
    height: 4px;
    border-radius: 2px;
    background: var(--ink-400);
    transform-origin: bottom;
    transition:
      height var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }
  .nav__sound[aria-pressed='true'] .bars i {
    background: var(--accent);
    height: calc(4px + var(--lvl, 0.5) * 10px);
  }
  .nav__sound[aria-pressed='true'] .bars i:nth-child(2) {
    height: calc(6px + var(--lvl, 0.5) * 8px);
  }
  .nav__cv {
    display: none;
    min-height: 44px;
  }
  .nav__menu {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-full);
    background: #f5f5f2;
    color: var(--ink-950);
    font-weight: 600;
    font-size: 0.875rem;
  }
  .nav__menu-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ink-950);
  }
  .nav__progress {
    pointer-events: none;
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
  }
  .nav__progress i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  @media (min-width: 1024px) {
    .nav__links {
      display: flex;
    }
    .nav__cv {
      display: inline-flex;
    }
    .nav__menu {
      display: none;
    }
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 20px var(--page-margin) max(28px, env(safe-area-inset-bottom));
    background: var(--ink-950);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__close {
    align-self: flex-end;
  }
  .menu__links {
    display: grid;
    gap: 6px;
    margin-block: auto;
  }
  .menu__links a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(2.75rem, 13vw, 5rem);
    animation: menu-in var(--dur-slow) var(--ease-out-expo) both;
    animation-delay: calc(var(--i) * 45ms);
  }
  .menu__links a:hover {
    color: var(--accent);
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(40%);
    }
  }
  .menu__foot {
    display: grid;
    gap: 14px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .menu__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
  }
</style>
