# Copy to .env (git-ignored). Never commit real values. See docs/PRD.md Appendix F.

# --- web build (apps/web) ---
PUBLIC_SITE_URL=https://dimas-portofolio.my.id
# seed | supabase
CONTENT_SOURCE=seed
# 1 = fail the build while placeholders remain
STRICT_PLACEHOLDERS=0
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_CONTACT_FUNCTION_URL=
PUBLIC_TRACK_FUNCTION_URL=

# --- admin build (apps/admin) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_PUBLIC_SITE_URL=https://dimas-portofolio.my.id

# --- local seeding only (scripts/seed-db.ts) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# format 62xxxxxxxxxx - never commit
SEED_WHATSAPP_NUMBER=

# --- Supabase function secrets (set with `supabase secrets set`, not here) ---
# TURNSTILE_SECRET_KEY, RESEND_API_KEY, CONTACT_TO_EMAIL, VERCEL_DEPLOY_HOOK_URL, ALLOWED_ORIGINS, IP_HASH_SALT
